# Скопируйте файл в .env и заполните значения.
# На текущем этапе (фундамент проекта) ключ LLM не нужен — он понадобится позже.

# API-ключ LLM (например, бесплатный Gemini API: https://aistudio.google.com/).
LLM_API_KEY=

# Модель, которая будет использоваться для анализа требований (на следующих этапах).
LLM_MODEL=gemini-2.0-flash
