# Скопируйте файл в .env и заполните значения.
# Реальный ключ и модели обязательны для запуска LLM-анализа.

# API-ключ OpenRouter: https://openrouter.ai/keys
# Формат ключа: sk-or-v1-...
LLM_API_KEY=your-openrouter-api-key

# OpenAI-совместимый endpoint. Для OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию. Используется этапом, у которого нет своей модели.
LLM_MODEL=anthropic/claude-haiku-5.5

# Модели по этапам. Быстрая модель извлекает требования из чанков,
# аудитор проверяет каждое требование и весь набор целиком.
# Если переменная этапа не задана, этап использует LLM_MODEL.
EXTRACTOR_MODEL=anthropic/claude-haiku-5.5
AUDITOR_MODEL=meta/muse-ember

# Режим рассуждений: оба этапа отправляют unified-поле reasoning.effort
# через extra_body (у SDK нет отдельного поля reasoning).
# Haiku 5.5: none | low | medium | high | xhigh | max
# Muse Ember: minimal | low | medium | high | xhigh | max  (none -> 400)
# Аудитору достаточно medium: причинный порядок полей JSON уже заставляет
# модель сначала цитировать и анализировать, а потом ставить severity.
EXTRACTOR_EFFORT=low
AUDITOR_EFFORT=medium

# Ограничений на число токенов ответа нет: используется лимит провайдера.

# Необязательные настройки (значения по умолчанию указаны справа):
# Таймаута запроса нет: лимит задаёт только провайдер/сеть.
# LLM_MAX_RETRIES=2
# LLM_CHUNK_MAX_CHARS=6000
# LLM_CHUNK_OVERLAP_CHARS=600
# AGENT_VERSION=0.2.0
