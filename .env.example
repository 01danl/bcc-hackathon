# Скопируйте файл в .env и заполните значения.
# Реальный ключ и модель обязательны для запуска LLM-анализа.

# API-ключ OpenRouter: https://openrouter.ai/keys
# Формат ключа: sk-or-v1-...
LLM_API_KEY=your-openrouter-api-key

# OpenAI-совместимый endpoint. Для OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1

# Идентификатор модели OpenRouter, например:
#   google/gemini-2.0-flash-001
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
# Модель должна поддерживать JSON output (response_format=json_object).
LLM_MODEL=your-model-id

# Необязательные настройки (значения по умолчанию указаны справа):
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_CHUNK_MAX_CHARS=6000
# LLM_CHUNK_OVERLAP_CHARS=600
# AGENT_VERSION=0.2.0
